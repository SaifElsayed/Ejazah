# Copy to .env. Every value here is a placeholder; no real secret ever lives in this file (R-SEC-1).
# The suite must pass with every provider variable UNSET (FR-054). Do not add a fake key to make a test pass.

# Required, no default (T168): development, test or production. The stand-in adapters ("fake" below) are accepted
# only under development and test; a configuration without this key is refused at startup, naming it (FR-039).
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Largest request body either API surface reads, in bytes; a larger one is refused with 413 (FR-077). 1 MiB.
# File uploads keep their own limit (NFR-SEC-9).
MAX_REQUEST_BODY_BYTES=1048576

# Two roles, two connection strings (research R-5).
# owner: holds the schema and runs migrations. application: what the API and worker connect as.
# The owner URL is used only by db:migrate and the pipeline; the runtime URL never carries owner credentials (R-5).
DATABASE_URL_OWNER=postgresql://ijazah_owner:owner@localhost:5432/ijazah
DATABASE_URL=postgresql://ijazah_app:app@localhost:5432/ijazah

REDIS_URL=redis://localhost:6379

# Column encryption key (research R-8). 32 bytes, base64. Required in EVERY environment, development included;
# there is no unencrypted code path (decided 2026-09-07, written into T015). Generate locally, never reuse across environments:
#   openssl rand -base64 32
ENCRYPTION_KEY=
# The key ENCRYPTION_KEY replaced, set only while a rotation runs and removed once the reencrypt-columns job reports no
# value remains under it (T155; docs/RUNBOOK.md, "Leaked credential"). Empty: no rotation is running.
ENCRYPTION_KEY_PREVIOUS=

# Storage port: "local" in development, "s3" in deployed environments (FR-055).
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=.storage
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Payment gateway (ADR 0007): direct checkout, 0% commission, zero custody. Gateway chosen per SRS OPEN-11.
# "fake" selects the stand-in (refused outside development and test, T146, T168). The webhook secret is what inbound events are verified
# against; with the stand-in, empty means a secret derived from ENCRYPTION_KEY (T121).
PAYMENT_GATEWAY=fake
PAYMENT_GATEWAY_API_KEY=
PAYMENT_GATEWAY_WEBHOOK_SECRET=

# Remaining ports: which adapter serves each is chosen here, at startup (FR-056). "fake" is the stand-in, the only
# one until the phase that first calls the port adds its real provider; empty means "fake". The credentials below
# belong to those real providers, and nothing reads them while the stand-in is selected.
VIDEO_PROVIDER=fake
PUSH_PROVIDER=fake
SMS_PROVIDER=fake
DAILY_API_KEY=
# Signing secret the video provider attaches to its lifecycle webhooks (joined, left, ended, outage).
# The kernel's signature guard verifies every inbound provider event against it on the raw body before any handler
# runs, per R-MONEY-9 (video-provider webhooks) and the kernel contract. The stand-in does not read it; a real provider requires it.
DAILY_WEBHOOK_SECRET=
SMS_PROVIDER_KEY=
EXPO_ACCESS_TOKEN=

# Externally reachable origin the gateway and the video provider POST webhooks to (ARCHITECTURE section 15).
# Locally this is a tunnel (Cloudflare Tunnel or ngrok), treated as configuration, e.g. https://example.trycloudflare.com
# Origin only: scheme and host, no path, no trailing slash. Empty means no webhook can reach this machine.
PUBLIC_WEBHOOK_ORIGIN=

# Browser origins the API answers cross-origin requests for (FR-076, NFR-SEC-11): the Admin panel's, comma-separated,
# each a bare origin (scheme and host, no path, no trailing slash). A wildcard is refused at startup. Empty means none,
# which is right for local development without the panel; the mobile app and webhooks send no Origin and are unaffected.
ADMIN_ALLOWED_ORIGINS=

SENTRY_DSN=
