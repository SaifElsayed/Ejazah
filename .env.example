# Copy to .env. Every value here is a placeholder; no real secret ever lives in this file (R-SEC-1).
# The suite must pass with every provider variable UNSET (FR-054). Do not add a fake key to make a test pass.

# Required, no default (T168): development, test or production. The stand-in adapters ("fake" below) are accepted
# only under development and test; a configuration without this key is refused at startup, naming it (FR-039).
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Largest request body either API surface reads, in bytes; a larger one is refused with 413 (FR-077). 1 MiB.
# File uploads keep their own limit (NFR-SEC-9).
MAX_REQUEST_BODY_BYTES=1048576

# Two roles, two connection strings (research R-5).
# owner: holds the schema and runs migrations. application: what the API and worker connect as.
# The owner URL is used only by db:migrate and the pipeline; the runtime URL never carries owner credentials (R-5).
DATABASE_URL_OWNER=postgresql://ijazah_owner:owner@localhost:5432/ijazah
DATABASE_URL=postgresql://ijazah_app:app@localhost:5432/ijazah
# The process's pool and session limits (T172): connections held at most, and the two Postgres timeouts every
# connection carries, in milliseconds. Positive integers; the defaults apply when unset.
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000

REDIS_URL=redis://localhost:6379

# How many queue deliveries the worker runs at once (T171, FR-052). A positive integer; 4 unless set.
# Every delivery is retried three times with exponential backoff, which is safe because every job is idempotent.
QUEUE_CONCURRENCY=4

# Column encryption key (research R-8). 32 bytes, base64. Required in EVERY environment, development included;
# there is no unencrypted code path (decided 2026-09-07, written into T015). Generate locally, never reuse across environments:
#   openssl rand -base64 32
ENCRYPTION_KEY=
# The key ENCRYPTION_KEY replaced, set only while a rotation runs and removed once the reencrypt-columns job reports no
# value remains under it (T155; docs/RUNBOOK.md, "Leaked credential"). Empty: no rotation is running.
ENCRYPTION_KEY_PREVIOUS=

# Storage port: "local" in development, "s3" in deployed environments (FR-055). "local" writes plaintext files, so
# outside development and test it is refused at startup (T147).
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=.storage
# The API's own origin (scheme and host, no path, no trailing slash), which local storage's signed links start with,
# served by the API's /files/ route. Unset, a local link stays relative and a document's link cannot be opened.
API_PUBLIC_ORIGIN=http://localhost:3000
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Payment gateway (ADR 0007, ADR 0025): direct checkout, zero custody; the teacher's share is split at checkout (T104).
# Gateway chosen per SRS OPEN-11.
# "fake" selects the stand-in (refused outside development and test, T146, T168). The webhook secret is what inbound events are verified
# against; with the stand-in, empty means a secret derived from ENCRYPTION_KEY (T121).
# "paymob" selects Paymob (T056): it needs the four keys below, the webhook secret and PUBLIC_WEBHOOK_ORIGIN.
# Values come from Paymob's dashboard; never commit one.
PAYMENT_GATEWAY=fake
# The payment mode (T109, SRS DEC-87), required, no default: "test" takes only the gateway's test keys (and the stand-in),
# and every app shows «نسخة تجريبية»; "live" takes only live keys (sk_live, pk_live), the split integration id below, and a
# payee on every checkout. Flipping to live needs no code change: set the live values from contracting and restart.
# Closed-test data is never carried to launch.
PAYMENT_MODE=test
# Not read by any adapter today (Paymob's calls use the secret key below).
PAYMENT_GATEWAY_API_KEY=
# The stand-in's signing secret, or Paymob's HMAC secret (dashboard: Settings, Account Info, HMAC).
PAYMENT_GATEWAY_WEBHOOK_SECRET=
# Paymob's secret key, sent as "Authorization: Token <key>" (dashboard: Settings, Developers, API Keys, Secret Key).
PAYMENT_GATEWAY_SECRET_KEY=
# Paymob's public key, which opens the hosted checkout (dashboard: Settings, Developers, API Keys, Public Key).
PAYMENT_GATEWAY_PUBLIC_KEY=
# Paymob's card integration id, a number (dashboard: Settings, Payment Integrations, the Test or Live table).
PAYMENT_GATEWAY_INTEGRATION_ID=
# Paymob's auth integration id for the split (Split Amount), a number; empty until Paymob enables the split at contracting.
PAYMENT_GATEWAY_SPLIT_INTEGRATION_ID=

# Remaining ports: which adapter serves each is chosen here, at startup (FR-056). "fake" is the stand-in, the only
# one until the phase that first calls the port adds its real provider; empty means "fake". The credentials below
# belong to those real providers, and nothing reads them while the stand-in is selected.
# The video port also takes "livekit" (Phase 3, specs/004-sessions/research.md R-302), which needs the three LIVEKIT_* below.
VIDEO_PROVIDER=fake
PUSH_PROVIDER=fake
SMS_PROVIDER=fake
# The LiveKit Cloud project's wss:// address, which sessions.join hands the app; not a secret.
LIVEKIT_URL=
# The project's API key and secret, from its settings. They authorise the server calls, sign every join token, and
# verify every video webhook on its raw body before any handler runs (R-SESS-7): LiveKit has no separate webhook secret.
# The stand-in reads none of the three; VIDEO_PROVIDER=livekit refuses to start without them.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
SMS_PROVIDER_KEY=
EXPO_ACCESS_TOKEN=
# The Typst CLI the worker renders certificates with (specs/005-certification T008, R-401): version 0.15.1, its path,
# e.g. /usr/local/bin/typst. Read by the worker only; unset, a certificate's render fails and the queue retries it.
TYPST_BIN=

# Phase 1 (specs/002-identity/contracts/ports.md): the sign-in port and the email port. "fake" is the stand-in for each,
# refused outside development and test like the ones above. EMAIL_FROM is the sender the email stand-in records, a reserved
# address by default; the live sender arrives with the provider chosen at launch.
SIGN_IN_PROVIDER=fake
EMAIL_PROVIDER=fake
EMAIL_FROM=no-reply@ijazah.invalid
# The live sign-in adapter's credentials (a later task). GOOGLE_CLIENT_IDS is a comma-separated list of audiences. Nothing
# reads them while SIGN_IN_PROVIDER is fake, and the test setup strips every one of them (FR-054).
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# The support address the apps show (FR-145, ADR 0021 D4). Required in every mode, a valid address, never an admin setting.
# The reserved placeholder is for local development only; a deployment sets the real mailbox.
SUPPORT_EMAIL=support@ijazah.invalid

# The one proxy header whose LAST hop is the client address, e.g. X-Forwarded-For (specs/002-identity/contracts/kernel.md,
# "Session resolution"): the hop the single trusted proxy appended, never the first, which the client writes itself.
# Set only when exactly one trusted proxy stands in front of the API; empty before launch, so the socket's peer is used.
TRUSTED_PROXY=
# The proxy's own IP address as the API's socket sees it, e.g. 10.0.0.2 (T147): the header is read only from this peer,
# and its last hop only when it is an IP address. Required when TRUSTED_PROXY is set; docs/RUNBOOK.md, "Hosted deploy".
TRUSTED_PROXY_ADDRESS=

# Externally reachable origin the gateway and the video provider POST webhooks to (ARCHITECTURE section 15).
# Locally this is a tunnel (Cloudflare Tunnel or ngrok), treated as configuration, e.g. https://example.trycloudflare.com
# Origin only: scheme and host, no path, no trailing slash. Empty means no webhook can reach this machine.
PUBLIC_WEBHOOK_ORIGIN=

# Browser origins the API answers cross-origin requests for (FR-076, NFR-SEC-11): the Admin panel's, comma-separated,
# each a bare origin (scheme and host, no path, no trailing slash). A wildcard is refused at startup. Empty means none,
# which is right for local development without the panel; the mobile app and webhooks send no Origin and are unaffected.
ADMIN_ALLOWED_ORIGINS=

# The Admin panel's own origin (scheme and host, no path, no trailing slash): an invited administrator's password-set
# link points at <origin>/set-password. Locally the panel's Vite server. Unset, an invite cannot be delivered.
ADMIN_PANEL_ORIGIN=http://localhost:5173

SENTRY_DSN=
