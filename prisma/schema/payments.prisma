// payments domain (T059, ERD section 7, ADR 0007). Owned by apps/api/src/modules/payments.
// payments (one row per gateway order: gateway_order_id unique, gateway_transaction_id unique, gross/fee/net as reported),
// payment_events (append-only signed events; provider_event_id unique NOT NULL). No balance column anywhere (FR-027).
// Every timestamp is timestamptz and ends _at; every money column is an integer ending _piasters (ERD section 0).
//
// Records of what the gateway did, never a balance: the gateway settles the teacher's share to the
// teacher and the platform holds no funds (FR-PAYG-1, ADR 0007, ADR 0025). Amounts are stored as the
// gateway reports them or as `packages/money` computed them, never computed here (R-MONEY-5).

// One row per gateway order. An enrollment may have several; at most one reaches `paid`, enforced by
// the confirm step being idempotent on the enrollment, not by an index (ERD section 7).
model Payment {
  id                      String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  enrollmentId            String         @map("enrollment_id") @db.Uuid
  // Which gateway took the order. Independent of the adapter config selects (R-API-4).
  gateway                 PaymentGateway
  // Created by the platform on the gateway (FR-PAYG-2). One record per order (ERD section 15.14):
  // NULLs do not collide. 006:T001 (R-509, N-3, PR #153 r3 Major 1): NULL only on an automatic order
  // `created` until the gateway answers, `expired` with no answer, or `failed` with a `hard`
  // decline refused before the gateway (ERD section 15 rule 72, in the migration).
  gatewayOrderId          String?        @unique @map("gateway_order_id")
  // Reported by the paid event. Unique where present: NULLs do not collide (ERD section 15.14).
  gatewayTransactionId    String?        @unique @map("gateway_transaction_id")
  // The snapshot price charged.
  grossPiasters           BigInt         @map("gross_piasters")
  // Reported by the gateway on the paid event.
  gatewayFeePiasters      BigInt?        @map("gateway_fee_piasters")
  // Settled to the teacher, `gross - fee` as reported.
  netPiasters             BigInt?        @map("net_piasters")
  // T104 (ADR 0025 D1, SRS DEC-80): the teacher's share rate read when the order was created, whole
  // percent, and the share it gave (gross times the rate, rounded up, by `packages/money`), the split
  // it asks for when a payee and a split integration exist. NULL on an order created before the
  // commission; both or neither, the share never above the gross (ERD section 15 rule 52).
  teacherShareRatePercent Int?           @map("teacher_share_rate_percent") @db.SmallInt
  teacherSharePiasters    BigInt?        @map("teacher_share_piasters")
  // 003:T102 (ADR 0025 D3, SRS DEC-82): the order's refunded total, the sum of the refunds the
  // gateway's signed child events reported (by `packages/money`), from 0 to the gross (ERD section
  // 15 rule 61); the order becomes `refunded` when it reaches the gross. `refundReportedAt`: when the
  // gateway first flagged a refund on the original payment, which reports no amount (Q-2 (a)).
  refundedPiasters        BigInt         @default(0) @map("refunded_piasters")
  refundReportedAt        DateTime?      @map("refund_reported_at") @db.Timestamptz(6)
  // 003:T105 (ADR 0025 D2, SRS DEC-81; the note under T105, Q-4 (a)): the percent of the teacher's
  // share released at half the sessions, read from `ijazah_half_release_percent` when an
  // `ijazah_track` order is created and kept on it; NULL on any other order. NULL or 0 to 100 (ERD
  // section 15 rule 64).
  halfReleaseRatePercent  Int?           @map("half_release_rate_percent") @db.SmallInt
  currency                String         @db.Char(3)
  // `refunded` is learned from the gateway's signed event; the platform never initiates one (FR-PAYG-10).
  status                  PaymentStatus
  // The order's expiry as created: no later than the hold's expiry minus the grace (T004,
  // data-model §2.4, FR-355). Read by Retry and by FR-BOOK-12's "still payable".
  expiresAt               DateTime       @map("expires_at") @db.Timestamptz(6)
  // The hosted checkout's address, encrypted (R-DB-8: it may carry a payment token), so FR-BOOK-12
  // (c) can offer "continue the previous payment"; NULL once the order leaves `created`. Read back
  // only by `checkout.continue` (data-model §2.4.1); reached by the `reencrypt-columns` job (002:T134).
  checkoutUrlEncrypted    Bytes?         @map("checkout_url_encrypted")
  // 006:T001 (R-502): what the order pays for, `package` on every order before the programme; the
  // instalment's month, set (1 and up) exactly on an `instalment` (ERD section 15 rule 70).
  kind                    OrderKind      @default(package)
  instalmentMonth         Int?           @map("instalment_month") @db.SmallInt
  // 006:T001 (R-508, R-509): an automatic charge of a saved card, its attempt (0 to 4, rule 71), and
  // why it failed, set on a `failed` automatic order.
  attempt                 Int?           @db.SmallInt
  automatic               Boolean        @default(false)
  declineKind             DeclineKind?   @map("decline_kind")
  // 006:T001 (R-502, V-3): the confirm step's marker for the order it processed, so a replayed
  // event finds it and does nothing.
  confirmedAt             DateTime?      @map("confirmed_at") @db.Timestamptz(6)
  createdAt               DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id])

  events           PaymentEvent[]
  enrollmentEvents EnrollmentEvent[]

  @@index([enrollmentId])
  // 006:T001 (R-502): an enrollment's orders by kind and month. Not unique: a second paid order for
  // a month is recorded and goes to the case (FR-718).
  @@index([enrollmentId, kind, instalmentMonth])
  @@map("payments")
}

// Every signed inbound gateway event, order and payout-recipient events alike, so one unique
// `provider_event_id` makes every replay a no-op (FR-PAYG-4). Append-only: never updated.
model PaymentEvent {
  id                  String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  // NULL exactly when `event_type` is `recipient_verified` or `recipient_rejected`, which concern a
  // teacher's payout account and no gateway order (FR-PAYG-15). The check is SQL in T064 (ERD
  // section 15.20).
  paymentId           String?          @map("payment_id") @db.Uuid
  // A replayed webhook cannot double-insert (FR-PAYG-4, R-MONEY-8, ERD section 15.13).
  providerEventId     String           @unique @map("provider_event_id")
  eventType           PaymentEventType @map("event_type")
  // Set by the signature guard before the row is written; no row exists for an unverified event
  // (R-MONEY-9).
  signatureVerifiedAt DateTime         @map("signature_verified_at") @db.Timestamptz(6)
  // A hash of the raw body, for audit; the body itself is never stored (R-SEC-2).
  payloadHash         String           @map("payload_hash")
  receivedAt          DateTime         @map("received_at") @db.Timestamptz(6)
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  // Restrict, not the optional relation's SET NULL: a NULL would turn an order event into a
  // recipient event (note under T059). RESTRICT on update too: a cascade would rewrite the row past
  // the revoked UPDATE (T135).
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([paymentId])
  @@map("payment_events")
}

// 003:T105 (ADR 0025 D2, SRS DEC-81, DEC-89; ERD section 7, changelog row 57): one release of a
// teacher's share per enrollment and milestone, written by the `release-teacher-shares` sweep when it
// falls due, the amount computed by `packages/money`. A record of what the gateway is to be told,
// never a balance: an administrator executes the release in the gateway's dashboard and marks it
// here, `marked_at` and `marked_by_admin_id` together, once (ERD section 15 rules 62 and 63). A
// release still held is computed on read, never stored.
model TeacherShareRelease {
  id              String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  enrollmentId    String                @map("enrollment_id") @db.Uuid
  // The enrollment's teacher, for the per-teacher lists.
  teacherUserId   String                @map("teacher_user_id") @db.Uuid
  milestone       ShareReleaseMilestone
  // Above zero (ERD section 15 rule 62).
  amountPiasters  BigInt                @map("amount_piasters")
  // When it fell due by its milestone's rule, not when the sweep wrote it.
  dueAt           DateTime              @map("due_at") @db.Timestamptz(6)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  // Both or neither (ERD section 15 rule 63).
  markedAt        DateTime?             @map("marked_at") @db.Timestamptz(6)
  markedByAdminId String?               @map("marked_by_admin_id") @db.Uuid

  enrollment    Enrollment @relation(fields: [enrollmentId], references: [id])
  teacher       User       @relation(fields: [teacherUserId], references: [id])
  markedByAdmin AdminUser? @relation(fields: [markedByAdminId], references: [id], onDelete: Restrict)

  // One release per enrollment and milestone (ERD section 15 rule 62); it serves the enrollment's
  // foreign key too.
  @@unique([enrollmentId, milestone])
  @@index([teacherUserId])
  @@index([markedByAdminId])
  @@map("teacher_share_releases")
}

// 006:T001 (R-510; ERD changelog row 73): the card a student consented to save at a programme's
// payment, one per programme, keyed by its enrollment. The token is encrypted by `ColumnCipher`, the
// row id bound (R-DB-8), never logged, audited or returned; `last4` and the brand are shown to the
// student only. The row is deleted by the close hook, at the programme's end, by the account's
// erasure, when the student turns the automatic renewal off (DEC-95), and at a teacher's suspension,
// ban or departure (DEC-94).
model ProgrammeCard {
  enrollmentId   String   @id @map("enrollment_id") @db.Uuid
  tokenEncrypted Bytes    @map("token_encrypted")
  last4          String
  brand          String
  // The student's consent at the payment that saved it.
  consentedAt    DateTime @map("consented_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id])

  @@map("programme_cards")
}
