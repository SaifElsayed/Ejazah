// catalog domain (T056, ERD section 4). Owned by apps/api/src/modules/catalog.
// subjects, teacher_subjects, packages, availability_slots, isnad_entries, teacher_signatures, and
// teacher_credentials (Phase 1, T011). Availability is local wall-clock beside an IANA zone column (R-TIME-3).
// Every timestamp is timestamptz and ends _at; every money column is an integer ending _piasters (ERD section 0).
//
// What the schema language cannot say lives in the migrations: one approved credential per teacher
// and subject, a partial unique (rule 23, T011); a package's shape by `is_programme` and its three
// prices above zero (rules 73 and 74, 006:T001).

// An administrator-managed list, named in both languages (FR-LOC-1).
model Subject {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  nameAr    String   @map("name_ar")
  nameEn    String   @map("name_en")
  isActive  Boolean  @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  teacherSubjects    TeacherSubject[]
  packages           Package[]
  teacherCredentials TeacherCredential[]
  enrollments        Enrollment[]
  ijazahs            Ijazah[]
  // Phase 4 (T001 of specs/005-certification): certification's requests, a back-relation only.
  ijazahRequests     IjazahRequest[]

  @@map("subjects")
}

model TeacherSubject {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  teacherUserId String   @map("teacher_user_id") @db.Uuid
  subjectId     String   @map("subject_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  teacher User    @relation(fields: [teacherUserId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])

  @@unique([teacherUserId, subjectId])
  @@index([subjectId])
  @@map("teacher_subjects")
}

model Package {
  id                     String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  teacherUserId          String       @map("teacher_user_id") @db.Uuid
  // A foreign key, not an enum.
  subjectId              String       @map("subject_id") @db.Uuid
  // 006:T001 (R-503): the three set on every package but a programme one, which holds NULL in each
  // and its three prices instead (ERD section 15 rule 73, in the migration). A programme's count,
  // length and total come at the offer.
  sessionCount           Int?         @map("session_count")
  // Must equal the slot's duration at booking (FR-PROFILE-8).
  sessionDurationMinutes Int?         @map("session_duration_minutes")
  // Integer piasters, charged in full through the gateway at checkout (FR-PAYG-1, R-MONEY-1).
  pricePiasters          BigInt?      @map("price_piasters")
  currency               String       @default("EGP") @db.Char(3)
  // The teacher's choice at creation (ADR 0018 D1; Phase 1, T012). The default is the migration's:
  // no row existed, and the service always writes it.
  track                  PackageTrack @default(recitation)
  // 006:T001 (R-503, DEC-94): a programme package, an `ijazah_track` one created while
  // `programme_enabled` is on; false on every other package, a pre-switch ijazah-track one included,
  // so the shape check and every reader branch on it, not on the track alone.
  isProgramme            Boolean      @default(false) @map("is_programme")
  // 006:T001 (R-503): a programme package's session price for each length, set exactly on one, each
  // above zero (ERD section 15 rules 73 and 74).
  price30Piasters        BigInt?      @map("price_30_piasters")
  price45Piasters        BigInt?      @map("price_45_piasters")
  price60Piasters        BigInt?      @map("price_60_piasters")
  // Deactivation never touches existing enrollments (FR-PROFILE-3).
  isActive               Boolean      @map("is_active")
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  teacher User    @relation(fields: [teacherUserId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])

  enrollments Enrollment[]
  slotHolds   SlotHold[]

  @@index([teacherUserId])
  @@index([subjectId])
  @@map("packages")
}

// Recurring weekly: a local wall-clock time beside the zone it is read in, never UTC (R-TIME-3).
model AvailabilitySlot {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  teacherUserId   String   @map("teacher_user_id") @db.Uuid
  // 0-6 with 0 = Sunday, as Postgres EXTRACT(DOW).
  dayOfWeek       Int      @map("day_of_week") @db.SmallInt
  // `HH:MM:SS`, the time package's LocalTime (packages/time).
  startTimeLocal  DateTime @map("start_time_local") @db.Time(0)
  durationMinutes Int      @map("duration_minutes")
  // The teacher's IANA zone at creation.
  timezone        String
  // Deactivation never affects generated sessions (FR-PROFILE-9).
  isActive        Boolean  @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  teacher User @relation(fields: [teacherUserId], references: [id])

  slotHolds       SlotHold[]
  enrollments     Enrollment[]
  // Phase 3 (T001): the slot a pending counter-proposal names, and its history (sessions' own).
  counterRemedies SessionRemedy[]
  counterEvents   SessionEvent[]

  @@index([teacherUserId])
  @@map("availability_slots")
}

// Phase 1 (T011, ADR 0017 D5, FR-104): one ijazah PDF per subject with its transcription; the chain
// hangs under it. A rejected credential stays as history; a new upload for the same subject is a
// new row. One approved credential per teacher and subject (rule 23, the partial unique in the
// migration). Owned by catalog; the document itself is verification's (R-109).
model TeacherCredential {
  id                       String                  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  teacherUserId            String                  @map("teacher_user_id") @db.Uuid
  subjectId                String                  @map("subject_id") @db.Uuid
  // The ijazah PDF.
  documentId               String                  @map("document_id") @db.Uuid
  // The teacher's full name as on the PDF, transcribed at approval (ADR 0019 D1).
  holderName               String?                 @map("holder_name")
  // Transcribed at approval, Arabic as typed (ADR 0021 D1).
  riwaya                   String?
  tariq                    String?
  status                   TeacherCredentialStatus
  // Mandatory on reject and needs_document; the teacher sees it.
  reviewReason             String?                 @map("review_reason")
  reviewedByAdminId        String?                 @map("reviewed_by_admin_id") @db.Uuid
  reviewedAt               DateTime?               @map("reviewed_at") @db.Timestamptz(6)
  // Whether it came with an application («عند التقدّم») or was added after approval (FR-PROFILE-11).
  submittedWithApplication Boolean                 @map("submitted_with_application")
  createdAt                DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  teacher         User                 @relation(fields: [teacherUserId], references: [id])
  subject         Subject              @relation(fields: [subjectId], references: [id])
  document        VerificationDocument @relation(fields: [documentId], references: [id])
  reviewedByAdmin AdminUser?           @relation(fields: [reviewedByAdminId], references: [id], onDelete: Restrict)

  isnadEntries IsnadEntry[]
  // R1a (002:T174): the credential's history, a back-relation only.
  history      TeacherCredentialHistory[]

  @@index([teacherUserId])
  @@index([subjectId])
  @@index([documentId])
  @@index([reviewedByAdminId])
  @@map("teacher_credentials")
}

// R1a (002:T174, SRS DEC-97, FR-AUTH-14; ERD §4, changelog row 63): one row per decision on the
// credential and per correction, with its note or reason and, on an approval and a correction, the
// name and the chain before and after; written once, never edited (rule 69, as the application's).
model TeacherCredentialHistory {
  id           String                         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  credentialId String                         @map("credential_id") @db.Uuid
  action       TeacherCredentialHistoryAction
  // Required except on approve; not blank, at most 1,000 characters (rule 68).
  note         String?
  // { holderName, riwaya, tariq, chain }: before only on a correction, after on an approval and a
  // correction (rule 68).
  before       Json?
  after        Json?
  adminId      String                         @map("admin_id") @db.Uuid
  createdAt    DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)

  credential TeacherCredential @relation(fields: [credentialId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  admin      AdminUser         @relation("TeacherCredentialHistoryAdmin", fields: [adminId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([credentialId, createdAt])
  @@index([adminId])
  @@map("teacher_credential_history")
}

// The chain of transmission, one generation per row under a credential, not a graph (FR-ISNAD-1..6).
// Re-keyed by ADR 0017 D5 (Phase 1, T011): transcribed by an administrator from the teacher's
// ijazah PDF, never typed by the teacher; a chain exists only on an approved credential, so no
// verification state of its own. The table held no row, so the old columns are dropped rather
// than deprecated; `IsnadVerificationStatus` stays declared (R-API-9).
model IsnadEntry {
  id               String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  credentialId     String   @map("credential_id") @db.Uuid
  // Origin first, counting toward the teacher.
  position         Int
  // One generation holds one or more names (ADR 0004 D3), Arabic as typed.
  names            String[]
  createdByAdminId String   @map("created_by_admin_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  credential     TeacherCredential @relation(fields: [credentialId], references: [id])
  createdByAdmin AdminUser         @relation(fields: [createdByAdminId], references: [id], onDelete: Restrict)

  // A chain cannot hold two generations at one position (rule 28, ERD section 15.7 as re-keyed).
  @@unique([credentialId, position])
  @@index([createdByAdminId])
  @@map("isnad_entries")
}

// Required before a generated ijazah is granted (FR-IJAZAH-12).
model TeacherSignature {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  teacherUserId String   @unique @map("teacher_user_id") @db.Uuid
  // Storage key, served only through a signed URL.
  storageKey    String   @map("storage_key")
  uploadedAt    DateTime @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  teacher User @relation(fields: [teacherUserId], references: [id])

  @@map("teacher_signatures")
}
