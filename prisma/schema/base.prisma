// Datasource, generator and EVERY centrally declared enum (T013, ERD section 0).
// Enums are declared once, here; a duplicate definition anywhere else fails the schema check.
//
// Two connection strings, one invariant (research R-5):
//   - Migrations run as the OWNER role. The owner URL (DATABASE_URL_OWNER) reaches the CLI only
//     through `datasource.url` in prisma.config.ts; Prisma 7 removed `url`/`directUrl` from this
//     block, so no URL is compiled into the schema or the generated client.
//   - The runtime connects as the APPLICATION role: the process that creates the single Prisma
//     client hands DATABASE_URL to a driver adapter. The generated client never sees the owner URL.
//
// Primary keys are UUID v7 (ERD section 0). PostgreSQL 18 ships `uuidv7()` natively, so every
// model declared by T055+ uses `id String @id @default(dbgenerated("uuidv7()")) @db.Uuid`.
// Every timestamp is `@db.Timestamptz(6)` and ends `_at` (research R-7); local wall-clock columns end
// `_local` beside a `timezone` column (R-TIME-3). Every foreign key is ON DELETE RESTRICT, so an optional
// relation states `onDelete: Restrict` (data-model.md section 4), and every foreign-key column carries an
// `@@index` unless a full unique or index already starts with it: PostgreSQL creates none (ERD section 14,
// FR-035).

datasource db {
  provider = "postgresql"
}

// `prisma-client-js` writes the client beside the `@prisma/client` package that `prisma generate`
// resolves (`pnpm db:generate`, T102), so `import { PrismaClient } from '@prisma/client'` reaches it
// in `apps/api` and in the root alike: both resolve one store copy, whose peers are the root's.
generator client {
  provider = "prisma-client-js"
}

// ---------------------------------------------------------------------------------------------
// Enums. One Postgres type each, named snake_case in the database (ARCHITECTURE section 16).
// Members are additive-only once published (R-API-9): never remove or rename one.
// ---------------------------------------------------------------------------------------------

// identity (ERD section 2)

enum Gender {
  male
  female

  @@map("gender")
}

// users.preferred_language and ijazahs.language (FR-LOC-4) share one type.
enum Language {
  ar
  en

  @@map("language")
}

enum AccountStatus {
  active
  suspended
  verification_required
  banned

  @@map("account_status")
}

enum Role {
  student
  teacher

  @@map("role")
}

enum RoleStatus {
  active
  suspended

  @@map("role_status")
}

// `revoked` (Phase 1, T011, FR-165): a withdrawn approval (FR-VERIFY-8, ADR 0016 D2); the teacher
// returns only through a new application. `suspended` stays the account-level word and is no
// longer written to this column.
enum TeacherVerificationStatus {
  pending
  approved
  rejected
  suspended
  banned
  revoked

  @@map("teacher_verification_status")
}

// Phase 1 (T011, specs/002-identity/data-model.md §3): what the applicant sees of the application,
// the queue's tab; `verification_status` stays the product's status.
// The verification call's outcome as the reviewer recorded it (FR-161; Phase 1, T068). `unsuitable`
// does not block approval: the reviewer decides, and may give it as the rejection's reason.
enum VerificationCallOutcome {
  suitable
  unsuitable

  @@map("verification_call_outcome")
}

enum TeacherApplicationStatus {
  in_review
  needs_document
  rejected
  banned
  approved

  @@map("teacher_application_status")
}

// Phase 1 (T011): the identity document's kind on an application and on a verification request
// (`VerifyIdentity`'s segmented control). One type for both columns: two enums with the same labels
// fail the schema check.
enum IdentityDocumentType {
  national_id
  passport

  @@map("identity_document_type")
}

// `account_deletion` is the web deletion's code (Phase 1, T009, FR-143).
enum OtpPurpose {
  signup
  login
  password_reset
  account_deletion

  @@map("otp_purpose")
}

// Phase 1 (T009, specs/002-identity/data-model.md §1): the two providers a sign-in is keyed by
// (ADR 0012 D2), and why a device's session was revoked (R-101).

enum AuthProvider {
  google
  apple

  @@map("auth_provider")
}

enum SessionRevokedReason {
  sign_out
  reuse_detected
  password_reset
  account_deleted
  account_suspended
  account_banned
  admin_action

  @@map("session_revoked_reason")
}

enum DevicePlatform {
  ios
  android

  @@map("device_platform")
}

// T097 (FR-155): what a banned person's kept identifier was made from, an address or a provider
// identity; the hash itself says nothing of it.
enum BannedIdentifierKind {
  email
  provider

  @@map("banned_identifier_kind")
}

// verification (ERD section 3)

enum VerificationDocumentType {
  national_id
  passport
  credential
  other

  @@map("verification_document_type")
}

enum VerificationRequestStatus {
  open
  satisfied
  expired
  // Phase 1 (T068): closed by a request for another document, which opened a new request; the row
  // keeps the document it held, so it stays referenced (B13b review, follow-up 1).
  replaced

  @@map("verification_request_status")
}

// catalog (ERD section 4)

// Declared but no longer carried by a column: ADR 0017 D5 dropped `isnad_entries.verification_status`
// (a chain exists only on an approved credential). It stays declared, as R-API-9 asks of what was
// published (Phase 1, T011).
enum IsnadVerificationStatus {
  unverified
  verified

  @@map("isnad_verification_status")
}

// Phase 1 (T011, ADR 0017 D5, FR-104): a credential's review state.
enum TeacherCredentialStatus {
  pending
  needs_document
  approved
  rejected

  @@map("teacher_credential_status")
}

// booking (ERD section 5)

// `confirmed` is written only by the confirm-enrollment job on a persisted paid event (FR-PAYG-5, R-HONEST-1).
enum EnrollmentStatus {
  pending_payment
  confirmed
  completed
  terminated_no_show
  cancelled

  @@map("enrollment_status")
}

enum CancellationReason {
  payment_expired
  payment_failed
  admin
  gender_correction
  teacher_suspended
  // Paid, but the database refused its confirmation (FR-PAYG-19, ADR 0010 D7).
  slot_unavailable
  // Its hold was released by the student's own new checkout (FR-BOOK-12, ADR 0010 D7).
  checkout_abandoned
  // The student deleted their account (ADR 0015 D4; Phase 1, T012).
  account_deleted

  @@map("cancellation_reason")
}

// Phase 2 (T004, specs/003-booking/data-model.md §2.5, R-216): the outcome an `enrollment_events`
// row records for a later notification (FR-385).
enum EnrollmentEventKind {
  confirmed
  order_failed
  cancelled

  @@map("enrollment_event_kind")
}

// Phase 1 (T012, ADR 0018 D1): every package has a track, and the enrollment keeps it in its
// snapshot (DEC-24). An ijazah can be requested only from the ijazah track (FR-IJAZAH-1).
enum PackageTrack {
  recitation
  ijazah_track

  @@map("package_track")
}

// Phase 1 (T012, ADR 0018 D2 to D4): what a session not consumed is owed, and where the remedy
// stands. The columns land now; the behaviour is Phase 3's.
enum RemedyKind {
  makeup
  refund

  @@map("remedy_kind")
}

enum RemedyStatus {
  awaiting_choice
  proposed
  counter_proposed
  booked
  refund_case

  @@map("remedy_status")
}

// sessions (ERD section 5)

// `under_threshold` and `provider_outage` leave only by admin action; no automatic transition exists (R-SESS-6).
enum SessionStatus {
  scheduled
  done
  student_no_show
  teacher_no_show
  both_no_show
  under_threshold
  provider_outage
  cancelled_by_agreement
  cancelled_by_admin
  disputed

  @@map("session_status")
}

enum ParticipantEventType {
  joined
  left

  @@map("participant_event_type")
}

enum CancellationRequestStatus {
  pending
  accepted
  declined
  expired

  @@map("cancellation_request_status")
}

// payments (ERD section 7, ADR 0007)

// One member per gateway a `payments` row can name (T059, note under T059 in tasks.md). `fake` is the
// recording stand-in, the port's second implementation from day one (ARCHITECTURE), so its rows exist
// in development and tests; production refuses it in config, not here. A real gateway's member is
// added when it is integrated (SRS OPEN-11). Members are permanent (R-API-9). The PAYMENT_GATEWAY env
// value selects the adapter (R-API-4) and shares the name `fake`. T056 adds `paymob` (FR-371, R-221),
// the PAYMENT_GATEWAY value of the same name.
enum PaymentGateway {
  fake
  paymob

  @@map("payment_gateway")
}

enum PaymentStatus {
  created
  paid
  failed
  expired
  refunded

  @@map("payment_status")
}

enum PaymentEventType {
  paid
  failed
  expired
  refunded
  recipient_verified
  recipient_rejected

  @@map("payment_event_type")
}

// certification (ERD section 8)

enum IjazahMode {
  generated
  uploaded

  @@map("ijazah_mode")
}

// moderation (ERD section 10)

enum DisputeKind {
  session_dispute
  compensation_case

  @@map("dispute_kind")
}

enum DisputeStatus {
  open
  resolved
  dismissed

  @@map("dispute_status")
}

// `compensation_ordered` records the decision only; execution happens outside the code path (FR-DISPUTE-6).
enum DisputeResolution {
  upheld
  re_marked
  no_show_recorded
  compensation_ordered
  party_suspended
  party_banned

  @@map("dispute_resolution")
}

enum GenderFlagStatus {
  open
  corrected
  fraud_ban
  dismissed

  @@map("gender_flag_status")
}

enum UserReportContext {
  session
  profile
  chat

  @@map("user_report_context")
}

enum UserReportStatus {
  open
  actioned
  dismissed

  @@map("user_report_status")
}

// notifications (ERD section 11)

// The FR-NOTIF-1 event list, one member per event, in the order the SRS states them (DEC-13c).
enum NotificationType {
  teacher_application_status_changed
  new_booking
  session_reminder
  no_show_recorded
  cancellation_requested
  cancellation_request_accepted
  cancellation_request_declined
  payment_confirmed
  payment_failed
  payment_expired
  payout_account_verified
  dispute_resolved
  gender_flag_resolved
  ijazah_granted
  ijazah_revoked
  new_review

  @@map("notification_type")
}

// platform kernel (ERD section 12, ADR 0008 D2)

enum IdempotencyKeyStatus {
  in_progress
  completed

  @@map("idempotency_key_status")
}
