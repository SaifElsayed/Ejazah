// booking (ERD section 5)

// `confirmed` is written only by the confirm-enrollment job on a persisted paid event (FR-PAYG-5, R-HONEST-1).
enum EnrollmentStatus {
  pending_payment
  confirmed
  completed
  terminated_no_show
  cancelled

  @@map("enrollment_status")
}

enum CancellationReason {
  payment_expired
  payment_failed
  admin
  gender_correction
  teacher_suspended
  // Paid, but the database refused its confirmation (FR-PAYG-19, ADR 0010 D7).
  slot_unavailable
  // Its hold was released by the student's own new checkout (FR-BOOK-12, ADR 0010 D7).
  checkout_abandoned
  // The student deleted their account (ADR 0015 D4; Phase 1, T012).
  account_deleted
  // 006:T001 (ADR 0024; specs/006-programme/data-model.md, ERD changelog row 65): a programme's
  // closings. The student declined the offer; the offer lapsed unpaid by `pay_by_at`; an approved
  // refusal of the assessment; an approved stop. Each frees the weekly time at once.
  offer_declined
  offer_lapsed
  assessment_refused
  programme_stopped

  @@map("cancellation_reason")
}

// Phase 3 (T001, specs/004-sessions/data-model.md §2.12, R-323 GAP-8): why a hold was released,
// written with `released_at` by every path that writes it; NULL while active and on a hold released
// before the column existed (ERD §15 rule 48).
enum HoldReleaseReason {
  converted
  expired
  checkout_abandoned
  slot_unavailable
  admin
  teacher_suspended
  account_deleted

  @@map("hold_release_reason")
}

// Phase 2 (T004, specs/003-booking/data-model.md §2.5, R-216): the outcome an `enrollment_events`
// row records for a later notification (FR-385).
enum EnrollmentEventKind {
  confirmed
  order_failed
  cancelled
  // Phase 3 (T001, data-model.md §2.8): an enrollment completed (FR-449), ended by an
  // administrator's decision on a student's complaint (FR-453), and restored by an administrator
  // (FR-454, R-322, ADR 0023).
  completed
  terminated_no_show
  restored
  // T069 (SRS FR-CANCEL-9; spec FR-503, FR-505): an administrator's release of a held slot (T070),
  // and a hold's end recorded by the hourly sweep (T074).
  slot_released
  slot_hold_ended
  // 006:T001 (ADR 0024; data-model.md, ERD changelog row 65): the programme's offer sent, its pause,
  // its resumption by a paid month, and an administrator's reopen of a stopped programme.
  programme_offered
  programme_paused
  programme_resumed
  programme_reopened

  @@map("enrollment_event_kind")
}

// 006:T001 (ADR 0024, R-501, R-505 to R-508; data-model.md «programmes», ERD changelog rows 65 and
// 71): where a programme stands. `awaiting_offer` from the assessment's confirmation, `offered` once
// the teacher sent the offer, `active` once the rest or month 1 is paid, `paused` while the next
// month is unpaid at its first occurrence, `closed` by the close hook (R-510). Members are permanent
// (R-API-9).
enum ProgrammeState {
  awaiting_offer
  offered
  active
  paused
  closed

  @@map("programme_state")
}

// 006:T001 (R-502, R-507): how the student pays the programme; NULL until the first payment.
enum ProgrammePlan {
  in_full
  monthly

  @@map("programme_plan")
}

// 006:T001 (R-513, I-2 (a), FR-706b): an item for an administrator. `stop` and `refusal` are the
// teacher's, with a reason; `no_offer` and `pay_blocked` are raised by the sweep. B-P3 (T014, SRS
// DEC-113; ERD changelog row 80): `charge_unknown`, the sweep's item for an automatic charge the
// gateway has not answered after `programme_charge_inquiry_tries` asks.
enum ProgrammeRequestKind {
  stop
  refusal
  no_offer
  pay_blocked
  charge_unknown

  @@map("programme_request_kind")
}

// 006:T001 (R-513): an item's state; `extended` only on a `no_offer` or `pay_blocked` item (ERD
// section 15 rule 80, in the migration).
enum ProgrammeRequestStatus {
  open
  approved
  declined
  withdrawn
  extended

  @@map("programme_request_status")
}

// Phase 1 (T012, ADR 0018 D1): every package has a track, and the enrollment keeps it in its
// snapshot (DEC-24). An ijazah can be requested only from the ijazah track (FR-IJAZAH-1).
enum PackageTrack {
  recitation
  ijazah_track

  @@map("package_track")
}

// Phase 1 (T012, ADR 0018 D2 to D4): what a session not consumed is owed, and where the remedy
// stands. The columns land now; the behaviour is Phase 3's.
enum RemedyKind {
  makeup
  refund

  @@map("remedy_kind")
}

enum RemedyStatus {
  awaiting_choice
  proposed
  counter_proposed
  booked
  refund_case
  // Phase 3 (T001, specs/004-sessions/data-model.md §2.3): a suspended student's open remedy, which
  // nothing advances until the reinstatement, and a deleted student's open remedy, closed with
  // nothing owed and no case.
  frozen
  lapsed

  @@map("remedy_status")
}

// sessions (ERD section 5)

// `under_threshold` and `provider_outage` leave only by admin action; no automatic transition exists (R-SESS-6).
enum SessionStatus {
  scheduled
  done
  student_no_show
  teacher_no_show
  both_no_show
  under_threshold
  provider_outage
  cancelled_by_agreement
  cancelled_by_admin
  disputed
  // 003:T112 (SRS FR-POSTPONE-1, DEC-90; ERD changelog row 59): a session its party postponed,
  // never evaluated, freeing both parties' time (ERD §15 rules 19 and 66). Members are permanent.
  postponed

  @@map("session_status")
}

enum ParticipantEventType {
  joined
  left
  // Phase 3 (T001, data-model.md §2.2): the provider's room-ended event, with no participant, which
  // closes every connection still open (FR-443, R-304).
  room_ended

  @@map("participant_event_type")
}

enum CancellationRequestStatus {
  pending
  accepted
  declined
  expired

  @@map("cancellation_request_status")
}

// Phase 3 (T001, data-model.md §2.4, R-315): what a `session_events` row records for a later
// notification (FR-495), twenty-five kinds. `complaint_raised` and `complaint_decided` are
// enrollment-wide rows with no session (R-322); `counter_booking_refused` is a teacher's acceptance
// of a counter-proposal that the database refused, never written as `counter_withdrawn` (A1).
enum SessionEventKind {
  settled
  cancellation_requested
  cancellation_accepted
  cancellation_declined
  cancellation_expired
  cancelled_by_admin
  remedy_offered
  counter_proposed
  counter_accepted
  counter_declined
  counter_withdrawn
  remedy_frozen
  makeup_booked
  remedy_handed_to_case
  remedy_lapsed
  dispute_raised
  dispute_resolved
  dispute_revised
  review_resolved
  outage_reclassified
  complaint_raised
  complaint_decided
  outcome_corrected
  instants_reresolved
  counter_booking_refused
  // 003:T112 (ERD changelog row 59): written for each session a postponement moves.
  postponed
  // 004:T084 (SRS DEC-105; ERD changelog row 78): a participant's phone could not encrypt the room.
  encryption_failed

  @@map("session_event_kind")
}

// payments (ERD section 7, ADR 0007)

// One member per gateway a `payments` row can name (T059, note under T059 in tasks.md). `fake` is the
// recording stand-in, the port's second implementation from day one (ARCHITECTURE), so its rows exist
// in development and tests; production refuses it in config, not here. A real gateway's member is
// added when it is integrated (SRS OPEN-11). Members are permanent (R-API-9). The PAYMENT_GATEWAY env
// value selects the adapter (R-API-4) and shares the name `fake`. T056 adds `paymob` (FR-371, R-221),
// the PAYMENT_GATEWAY value of the same name.
enum PaymentGateway {
  fake
  paymob

  @@map("payment_gateway")
}

enum PaymentStatus {
  created
  paid
  failed
  expired
  refunded

  @@map("payment_status")
}

enum PaymentEventType {
  paid
  failed
  expired
  refunded
  recipient_verified
  recipient_rejected
  // 003:T102 (Q-2 (a)'s safety net, DEC-82; ERD changelog row 56): a refund the gateway flagged on
  // the original payment, which reports no amount.
  refund_reported
  // 006:T001 (R-510; ERD changelog row 65): the gateway's token callback for a card the student
  // consented to save, recorded under `paymob:<txId>:token`.
  card_saved

  @@map("payment_event_type")
}

// 006:T001 (R-502; ERD changelog rows 65 and 66): what an order pays for. `package` is today's order
// and every existing row's; `assessment` the programme's first; `rest_in_full` and `instalment` the
// offer's. Members are permanent (R-API-9).
enum OrderKind {
  package
  assessment
  rest_in_full
  instalment

  @@map("order_kind")
}

// 006:T001 (R-509; ERD changelog row 67): why an automatic order failed. A `soft` decline is
// retried; a `hard` one, refused before the gateway (`no_payee`), never is.
enum DeclineKind {
  soft
  hard

  @@map("decline_kind")
}

// 003:T105 (ADR 0025 D2, SRS DEC-81; ERD changelog row 57): why a release of the teacher's share
// fell due. Members are permanent (R-API-9).
enum ShareReleaseMilestone {
  recitation_end
  ijazah_half
  ijazah_end
  teacher_dropout
  student_complaint_close
  // 006:T001 (R-512, DEC-94; ERD changelog row 65): the assessment's release when the student does
  // not continue, and a programme closed by an approved stop.
  assessment
  programme_stopped
  // 003:T125 (SRS DEC-104; ERD changelog row 77): an administrator's direct end on the student's
  // stop, a student's deletion by an administrator and a gender correction.
  direct_end

  @@map("share_release_milestone")
}

