// verification domain (T055, ERD section 3). Owned by apps/api/src/modules/verification.
// verification_documents, verification_requests.
// Every timestamp is timestamptz and ends _at; every money column is an integer ending _piasters (ERD section 0).

// Uploaded identity and credential documents (FR-VERIFY-1). An administrator views, never modifies.
model VerificationDocument {
  id                  String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  // A teacher applicant, or any user under an FR-VERIFY-10 request.
  userId              String                   @map("user_id") @db.Uuid
  documentType        VerificationDocumentType @map("document_type")
  // An identity-document reference, encrypted in the column itself (R-DB-8). Signed-URL access only.
  // Null once the file is gone after its person's deletion (B16, decision 1): never before
  // `erased_at`, which rule 34 holds.
  storageKeyEncrypted Bytes?                   @map("storage_key_encrypted")
  // The PDF's size in bytes, recorded at upload (T057, owner's decision 2026-10-21); null for a document
  // uploaded before it was recorded. The file's name is never stored (it may carry the person's name).
  sizeBytes           Int?                     @map("size_bytes")
  uploadedAt          DateTime                 @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  // Set in the deletion's transaction of the person who uploaded it (ADR 0015 D3; B16, decision 1);
  // the key is cleared after the commit, only once the file is removed.
  erasedAt            DateTime?                @map("erased_at") @db.Timestamptz(6)
  // Set at the deletion of a teacher ever approved on an identity or credential document it keeps
  // (T069, T076; SRS DEC-67, spec FR-508); never with `erased_at` (rule 34 as widened by T069).
  keptAt              DateTime?                @map("kept_at") @db.Timestamptz(6)
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  // Phase 1 (T011): the rows that point at a document, each ON DELETE RESTRICT.
  teacherCredentials   TeacherCredential[]
  identityOfProfiles   TeacherProfile[]
  verificationRequests VerificationRequest[]

  @@index([userId])
  @@map("verification_documents")
}

// An administrator's "provide ID" demand (FR-VERIFY-10), distinct from the teacher application.
model VerificationRequest {
  id                 String                    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId             String                    @map("user_id") @db.Uuid
  requestedByAdminId String                    @map("requested_by_admin_id") @db.Uuid
  // Mandatory.
  reason             String
  // An open request puts the account in `verification_required`.
  status             VerificationRequestStatus
  // Phase 1 (T011, FR-166): the document the user submitted for the request (`VerifyIdentity`) and
  // its kind; null until submitted.
  documentId         String?                   @map("document_id") @db.Uuid
  documentType       IdentityDocumentType?     @map("document_type")
  createdAt          DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt         DateTime?                 @map("resolved_at") @db.Timestamptz(6)
  updatedAt          DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user             User                  @relation(fields: [userId], references: [id])
  requestedByAdmin AdminUser             @relation(fields: [requestedByAdminId], references: [id], onDelete: Restrict)
  document         VerificationDocument? @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([requestedByAdminId])
  @@index([documentId])
  @@map("verification_requests")
}
