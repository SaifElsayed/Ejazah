// moderation domain (T061, ERD section 10). Owned by apps/api/src/modules/moderation.
// disputes, gender_flags, user_reports.
// Every timestamp is timestamptz and ends _at; every money column is an integer ending _piasters (ERD section 0).
//
// Phase 3 (T001, specs/004-sessions/data-model.md §2.7): `kind` gains `absence_complaint` and
// `resolution` `enrollment_ended` (R-322). ERD §15 rule 46, its checks and its two partial uniques
// (one open session dispute per session, one open complaint per enrollment), lives in migration
// `20261108120000_sessions_pass`.
//
// Phase 4 (T001 of specs/005-certification, data-model.md; R-408, R-409): `user_reports.enrollment_id`
// and `gender_flags.reason` and `report_id`. The migration `20261117…_certification_foundations`
// holds what the schema language cannot say: the partial uniques `user_reports_one_open_key` and
// `gender_flags_one_open_per_user_key`, and the checks `user_reports_not_self_check` and
// `user_reports_context_check`.

// The moderation case table (ADR 0007 D5). Every case belongs to one enrollment.
model Dispute {
  id                String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  enrollmentId      String             @map("enrollment_id") @db.Uuid
  // Set for a session dispute; NULL for an enrollment-level compensation case (FR-DISPUTE-5).
  sessionId         String?            @map("session_id") @db.Uuid
  // `compensation_case` rows are opened automatically by termination flows (FR-DISPUTE-5).
  kind              DisputeKind
  // Within the dispute window only (FR-DISPUTE-1); NULL when opened by the system.
  raisedByUserId    String?            @map("raised_by_user_id") @db.Uuid
  reason            String
  // An open session dispute freezes the session's outcome (FR-DISPUTE-4).
  status            DisputeStatus
  // `compensation_ordered` records the decision only; execution is outside the code path (FR-DISPUTE-6).
  resolution        DisputeResolution?
  // Mandatory on resolve.
  resolutionNotes   String?            @map("resolution_notes")
  resolvedByAdminId String?            @map("resolved_by_admin_id") @db.Uuid
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt        DateTime?          @map("resolved_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  // On a closed `student_suspended` case only (ERD §15 rule 49): the case that owes the sessions
  // its suspension cancelled (B39, the owner's decision (c) on PR #133's Major 1; ERD row 34).
  coveredByCaseId   String?            @map("covered_by_case_id") @db.Uuid

  enrollment      Enrollment @relation(fields: [enrollmentId], references: [id])
  session         Session?   @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  raisedBy        User?      @relation(fields: [raisedByUserId], references: [id], onDelete: Restrict)
  resolvedByAdmin AdminUser? @relation(fields: [resolvedByAdminId], references: [id], onDelete: Restrict)
  coveredBy       Dispute?   @relation("CaseCoveredBy", fields: [coveredByCaseId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  // Phase 1 (T012, ADR 0018): the refund cases that point at this dispute.
  remedies      SessionRemedy[]
  // Phase 3 (T001): the session events that name this case, dispute or complaint.
  sessionEvents SessionEvent[]
  // B39: the closed suspension cases whose sessions this case owes.
  covering      Dispute[]      @relation("CaseCoveredBy")

  @@index([enrollmentId])
  @@index([sessionId])
  @@index([raisedByUserId])
  @@index([resolvedByAdminId])
  @@index([coveredByCaseId])
  @@map("disputes")
}

model GenderFlag {
  id                String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  flaggedUserId     String           @map("flagged_user_id") @db.Uuid
  // NULL when an administrator raised it (FR-GENDER-3).
  raisedByUserId    String?          @map("raised_by_user_id") @db.Uuid
  // Outcomes per FR-GENDER-6/7.
  status            GenderFlagStatus
  // Phase 4 (T001, data-model.md): the raiser's reason.
  reason            String
  // Phase 4 (T001, data-model.md): the report an administrator raised it from, if any.
  reportId          String?          @map("report_id") @db.Uuid
  resolutionNotes   String?          @map("resolution_notes")
  resolvedByAdminId String?          @map("resolved_by_admin_id") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt        DateTime?        @map("resolved_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  flaggedUser     User        @relation("GenderFlagFlagged", fields: [flaggedUserId], references: [id])
  raisedBy        User?       @relation("GenderFlagRaisedBy", fields: [raisedByUserId], references: [id], onDelete: Restrict)
  resolvedByAdmin AdminUser?  @relation(fields: [resolvedByAdminId], references: [id], onDelete: Restrict)
  report          UserReport? @relation(fields: [reportId], references: [id], onDelete: Restrict)

  @@index([flaggedUserId])
  @@index([raisedByUserId])
  @@index([resolvedByAdminId])
  @@index([reportId])
  @@map("gender_flags")
}

// A report from any session or profile (FR-SESS-15).
model UserReport {
  id                String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  reportedUserId    String            @map("reported_user_id") @db.Uuid
  reporterUserId    String            @map("reporter_user_id") @db.Uuid
  context           UserReportContext
  // Extends chat retention while open (FR-SESS-13).
  sessionId         String?           @map("session_id") @db.Uuid
  // Phase 4 (T001, data-model.md; R-408): the enrollment of a session or chat report, set by the
  // server (`user_reports_context_check`); the chat purge reads it.
  enrollmentId      String?           @map("enrollment_id") @db.Uuid
  reason            String
  status            UserReportStatus
  // B47 (005:T011, the owner's Q-R3 (a)): the note `reports.resolve` takes (FR-612). Open ⇔ no
  // `resolved_at` ⇔ no `resolved_by_admin_id` (`user_reports_resolved_check`, ERD §15 rule 59).
  resolutionNotes   String?           @map("resolution_notes")
  resolvedByAdminId String?           @map("resolved_by_admin_id") @db.Uuid
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt        DateTime?         @map("resolved_at") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  reportedUser    User         @relation("UserReportReported", fields: [reportedUserId], references: [id])
  reporter        User         @relation("UserReportReporter", fields: [reporterUserId], references: [id])
  session         Session?     @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  enrollment      Enrollment?  @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  resolvedByAdmin AdminUser?   @relation(fields: [resolvedByAdminId], references: [id], onDelete: Restrict)
  genderFlags     GenderFlag[]

  @@index([reportedUserId])
  @@index([reporterUserId])
  @@index([sessionId])
  @@index([enrollmentId])
  @@index([resolvedByAdminId])
  @@map("user_reports")
}
