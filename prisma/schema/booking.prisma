// booking domain (T057, ERD section 5). Owned by apps/api/src/modules/booking.
// slot_holds, enrollments, enrollment_events (T004, append-only, ERD section 15.39). enrollments: deleted_at, status (pending_payment · confirmed · completed · terminated_no_show · cancelled), confirmed_at (one write path, FR-PAYG-5), cancellation_reason. Sessions tables live in sessions.prisma (ADR 0005 D2); payment records in payments.prisma (ADR 0007).
// Every timestamp is timestamptz and ends _at; every money column is an integer ending _piasters (ERD section 0).
//
// What the schema language cannot say lives in the migrations: the student-is-not-teacher check
// (T064, ERD section 15.2), the two partial uniques on active holds (T066, section 15.17-18) and the
// revoked DELETE on enrollments (T065, section 15.10), and the partial index on the held closings
// (T069 of specs/004-sessions/tasks.md, section 14).

// A checkout reservation with a TTL (FR-BOOK-9). NULL `released_at` means active, even past
// `expires_at`: at most one active hold per slot and per student (T066, ADR 0010 D1, D6).
model SlotHold {
  id            String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  slotId        String             @map("slot_id") @db.Uuid
  studentUserId String             @map("student_user_id") @db.Uuid
  // The package the hold was placed for, as the placement checked it (B29, T036; the owner's
  // decision of 2026-11-03): Pay names the hold alone, and a teacher may have several packages of
  // the slot's length.
  packageId     String             @map("package_id") @db.Uuid
  // The package's session count when the hold was placed, the count the hold's overlap check ran
  // on (FR-351); Pay refuses a package whose count changed since (the owner's decision of 2026-11-03).
  sessionCount  Int                @map("session_count")
  // Set in the transaction that creates the enrollment at Pay; NULL while the student is in
  // checkout before Pay (ADR 0010 D2).
  enrollmentId  String?            @map("enrollment_id") @db.Uuid
  // Gateway checkout TTL plus the hold grace, counted from placement (FR-BOOK-9, ADR 0010 D4).
  expiresAt     DateTime           @map("expires_at") @db.Timestamptz(6)
  // Never set by a failed gateway event (ADR 0010 D4). A release without conversion cancels the
  // linked enrollment in the same transaction (ADR 0010 D7).
  releasedAt    DateTime?          @map("released_at") @db.Timestamptz(6)
  // Why it was released, written with `released_at` by every path that writes it; NULL while
  // active and on a hold released before the column existed (Phase 3, T001; data-model.md §2.12;
  // ERD §15 rule 48). No index (R-DB-9).
  releaseReason HoldReleaseReason? @map("release_reason")
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  slot       AvailabilitySlot @relation(fields: [slotId], references: [id])
  package    Package          @relation(fields: [packageId], references: [id])
  student    User             @relation(fields: [studentUserId], references: [id])
  enrollment Enrollment?      @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)

  @@index([slotId])
  @@index([packageId])
  @@index([studentUserId])
  @@index([enrollmentId])
  @@map("slot_holds")
}

// One student's purchase of one package. Snapshots everything a mutable parent could change
// (FR-PROFILE-3); `sessions_remaining` is derived, never stored (R-DB-4).
model Enrollment {
  id                          String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  studentUserId               String              @map("student_user_id") @db.Uuid
  // Denormalised for query sanity; never the student (T064, FR-BOOK-11).
  teacherUserId               String              @map("teacher_user_id") @db.Uuid
  packageId                   String              @map("package_id") @db.Uuid
  slotId                      String              @map("slot_id") @db.Uuid
  snapshotPricePiasters       BigInt              @map("snapshot_price_piasters")
  snapshotSessionCount        Int                 @map("snapshot_session_count")
  snapshotDurationMinutes     Int                 @map("snapshot_duration_minutes")
  snapshotSubjectId           String              @map("snapshot_subject_id") @db.Uuid
  // The zone frozen at purchase; DST arithmetic uses this.
  snapshotSlotTimezone        String              @map("snapshot_slot_timezone")
  // The package's track at purchase (ADR 0018 D1, DEC-24; Phase 1, T012). The default is the
  // migration's, as `packages.track`'s is; the booking service always copies the package's.
  snapshotTrack               PackageTrack        @default(recitation) @map("snapshot_track")
  // `confirmed` only by the confirm-enrollment job on the gateway's paid event (FR-PAYG-5).
  status                      EnrollmentStatus
  // Set once, by the confirm-enrollment job. There is no other write path (R-HONEST-1).
  confirmedAt                 DateTime?           @map("confirmed_at") @db.Timestamptz(6)
  // Why a `cancelled` enrollment was cancelled (ADR 0010 D7).
  cancellationReason          CancellationReason? @map("cancellation_reason")
  // Soft deletion: DELETE is revoked from the application role (T065, ERD section 15.10).
  deletedAt                   DateTime?           @map("deleted_at") @db.Timestamptz(6)
  purchasedAt                 DateTime            @map("purchased_at") @db.Timestamptz(6)
  // The first session's local date the checkout showed, computed at Pay; compared with session 1
  // to say the first session moved (T004, data-model §2.3, R-209, FR-368, FR-386).
  quotedFirstSessionLocalDate DateTime            @map("quoted_first_session_local_date") @db.Date
  // When an administrator released the slot of a closed enrollment before its hold ended (T069,
  // T070; SRS FR-CANCEL-9, spec FR-503). The held closings carry a partial index in the migration,
  // for the hourly sweep that records a hold's end (T074, spec FR-505).
  slotReleasedAt              DateTime?           @map("slot_released_at") @db.Timestamptz(6)
  // The reason both parties are shown of an administrator's direct end (T082; SRS FR-CANCEL-10,
  // spec FR-513), cleared by the restore; only on a `cancelled` `admin` enrollment, 1 to 500
  // characters (rule 51, a check in the migration). The internal note is in the audit entry only.
  adminEndReason              String?             @map("admin_end_reason")
  createdAt                  DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  student         User             @relation("EnrollmentStudent", fields: [studentUserId], references: [id])
  teacher         User             @relation("EnrollmentTeacher", fields: [teacherUserId], references: [id])
  package         Package          @relation(fields: [packageId], references: [id])
  slot            AvailabilitySlot @relation(fields: [slotId], references: [id])
  snapshotSubject Subject          @relation(fields: [snapshotSubjectId], references: [id])

  slotHolds     SlotHold[]
  sessions      Session[]
  payments      Payment[]
  chatMessages  ChatMessage[]
  ijazahs       Ijazah[]
  review        Review?
  disputes      Dispute[]
  events        EnrollmentEvent[]
  // Phase 3 (T001): sessions' record of the enrollment's session events.
  sessionEvents SessionEvent[]

  @@index([studentUserId])
  @@index([teacherUserId])
  @@index([packageId])
  @@index([slotId])
  @@index([snapshotSubjectId])
  @@map("enrollments")
}

// T004 (data-model §2.5, R-216): the append-only record of each outcome a later notification needs
// (FR-385). The two kind checks and the revoked UPDATE, DELETE and TRUNCATE are SQL in the
// migration (ERD section 15.39). RESTRICT on update as on delete: a cascade would rewrite the row
// past the revoked UPDATE (002:T135).
model EnrollmentEvent {
  id                 String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  enrollmentId       String              @map("enrollment_id") @db.Uuid
  kind               EnrollmentEventKind
  // Set exactly when `kind` is `cancelled`.
  cancellationReason CancellationReason? @map("cancellation_reason")
  // The order that failed (`order_failed`) or that confirmed the enrollment (`confirmed`), so a
  // later paid order is told apart from a replay (FR-375). A reference only: booking never reads a
  // `payments` row (R-API-6).
  paymentId          String?             @map("payment_id") @db.Uuid
  // The instant of the transaction that recorded the outcome.
  occurredAt         DateTime            @map("occurred_at") @db.Timestamptz(6)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  payment    Payment?   @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([enrollmentId])
  @@index([paymentId])
  @@map("enrollment_events")
}
