{
  "name": "ijazah",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=24.7 <25",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "pnpm --parallel --recursive --filter \"./apps/**\" --filter \"!@ijazah/mobile\" run \"/^dev(:worker)?$/\"",
    "build": "pnpm --recursive run build",
    "typecheck": "tsc --build",
    "lint": "eslint .",
    "lint:types": "eslint . --config eslint.types.config.js",
    "test": "vitest run",
    "test:violations": "vitest run tests/violations",
    "test:db-integrity": "vitest run tests/db-integrity",
    "test:adversarial": "vitest run tests/adversarial",
    "infra:up": "docker compose up --detach --wait",
    "infra:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:checksum": "tsx scripts/seed-checksum.ts",
    "db:schema:check": "tsx scripts/schema-check.ts",
    "contract:snapshot": "tsx --conditions=@ijazah/source scripts/contract-snapshot.ts",
    "tokens:build": "tsx scripts/build-tokens.ts",
    "check:generated": "tsx --conditions=@ijazah/source scripts/generated-file-check.ts",
    "check:branch": "tsx scripts/branch-spec-check.ts",
    "check:migrations": "tsx scripts/migration-check.ts",
    "check:suppressions": "tsx scripts/suppression-gate.ts",
    "check:magic-numbers": "tsx scripts/magic-number-gate.ts",
    "check:i18n": "tsx scripts/i18n-key-parity.ts",
    "check:i18n:admin": "tsx scripts/i18n-key-parity.ts --ar apps/admin/src/i18n/ar.json --en apps/admin/src/i18n/en.json",
    "check:suites": "tsx scripts/suite-gate.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@prisma/client": "7.10.0",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "4.1.11",
    "dotenv": "17.4.2",
    "eslint": "10.10.0",
    "husky": "9.1.7",
    "pg": "8.23.1",
    "prettier": "3.9.6",
    "prisma": "7.10.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "packageExtensions": {
      "@react-native/jest-preset@0.88.0": {
        "peerDependencies": {
          "react-native": "*"
        }
      },
      "react-native-svg@15.16.0": {
        "peerDependencies": {
          "@types/react": "*"
        },
        "peerDependenciesMeta": {
          "@types/react": {
            "optional": true
          }
        }
      },
      "react-native-css-interop@0.2.7": {
        "dependencies": {
          "@expo/config": "58.0.6",
          "connect": "3.7.0",
          "metro-transform-worker": "0.87.1"
        }
      }
    }
  }
}
