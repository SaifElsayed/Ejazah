{
  "name": "@ijazah/api",
  "version": "0.0.0",
  "private": true,
  "description": "Backend: tRPC over Nest. Two separately mounted surfaces (user, administrator). The queue worker is a second process of this app, not a fourth application.",
  "type": "module",
  "scripts": {
    "dev": "tsc-watch -p tsconfig.json --onSuccess \"node --env-file-if-exists=../../.env dist/main.js\"",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1138.0",
    "@aws-sdk/s3-request-presigner": "3.1138.0",
    "@ijazah/contracts": "workspace:*",
    "@ijazah/money": "workspace:*",
    "@ijazah/time": "workspace:*",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@sentry/node": "11.4.0",
    "@trpc/server": "11.19.0",
    "bullmq": "6.3.11",
    "ioredis": "5.11.1",
    "pino": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "tsc-watch": "7.2.1"
  }
}
