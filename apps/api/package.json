{
  "name": "@ijazah/api",
  "version": "0.0.0",
  "private": true,
  "description": "Backend: tRPC over Nest. Two separately mounted surfaces (user, administrator). The queue worker is a second process of this app, not a fourth application.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc --build",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --build",
    "test": "vitest run"
  },
  "dependencies": {
    "@ijazah/contracts": "workspace:*",
    "@ijazah/money": "workspace:*",
    "@ijazah/time": "workspace:*",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@trpc/server": "11.18.0",
    "bullmq": "6.3.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
