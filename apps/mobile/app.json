{
  "expo": {
    "name": "Ijazah",
    "slug": "ijazah",
    "scheme": "ijazah",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "extra": {
      "supportsRTL": true,
      "forcesRTL": true
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-status-bar",
      "expo-secure-store",
      "@react-native-google-signin/google-signin"
    ]
  }
}
