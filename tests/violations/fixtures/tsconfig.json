{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2023",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"],
    "jsx": "preserve",
    "strict": true,
    "noEmit": true,
    "types": []
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
