      "account.me": {
        "caller": "user",
        "input": { "$": { "type": "unknown" } },
        "kind": "query",
        "output": {
          "$": { "type": "object" },
          "$.accountStatus": {
            "required": true,
            "type": "string",
            "values": ["active", "banned", "suspended", "verification_required"]
