{
  "name": "@ijazah/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "The only shared type surface: router types, Zod schemas, shared enums. Additive-only from the moment a member exists (R-API-9).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@ijazah/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "zod": "4.5.4"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  }
}
