# The environment of scripts/ops/backup.ts (R2 T179; docs/RUNBOOK.md, «Backups and restore»).
# Names only: copy this file to the server (e.g. /etc/ijazah/backup.env, owner root, mode 0600) and
# fill it there, never in the repository. It is not the API's `.env`, and the API never reads it.

# The owner role's connection, which `dump` runs as (it reads `_prisma_migrations`, which the
# application role cannot). `restore` refuses a target whose database this URL names.
DATABASE_URL_OWNER=
# The API's own connection, read by `restore` only, to refuse its database as a target.
DATABASE_URL=

# A file holding the gpg passphrase on its first line (owner root, mode 0400). Its second copy is in
# the owner's password manager, under the deployment's entry (with ENCRYPTION_KEY's and VIDEO_MEDIA_KEY_SECRET's).
BACKUP_PASSPHRASE_FILE=

# The backup bucket and its own token: Object Read & Write on this bucket only. Only this script
# holds it, so a leaked API key cannot delete a backup.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# The documents bucket (the API's S3_BUCKET) through a read-only token, for `copy-documents`.
DOCUMENTS_S3_ENDPOINT=
DOCUMENTS_S3_REGION=
DOCUMENTS_S3_BUCKET=
DOCUMENTS_S3_ACCESS_KEY_ID=
DOCUMENTS_S3_SECRET_ACCESS_KEY=

# The three programs, each a program and its leading arguments split on spaces. Unset: pg_dump,
# pg_restore and gpg from PATH. pg_dump and pg_restore must be at least the server's major version.
BACKUP_PG_DUMP=
BACKUP_PG_RESTORE=
BACKUP_GPG=
